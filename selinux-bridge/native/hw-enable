#!/usr/bin/env bash
#
# hw-enable -- make the phone's hardware native to every application in this
# container, present and future.
#
# The bridge already reaches the hardware, but until now every consumer had
# to know about it: a special launcher for the GPU, a FIFO path for the
# camera, a hand-picked PulseAudio source for the microphone, a different
# ffmpeg binary for the hardware codecs. That is integration by convention,
# and it only works for applications somebody remembered to wire up.
#
# This installs the same four capabilities where the standard Linux
# interfaces are, so an application that knows nothing about any of this
# finds them by looking in the ordinary places:
#
#   camera  -> /dev/video0, a real V4L2 capture node (native/v4l2-shim.c),
#              listed in /sys/class/video4linux so that libudev-based
#              enumeration finds it (native/sysfs-shim.c, native/netlink-shim.c)
#   mic     -> the default PulseAudio source
#   GPU     -> session-wide for GL (Turnip+Zink), and for Chromium and
#              Electron applications via native/pci-shim.c
#   codecs  -> ffmpeg on PATH is the build that has the bridge encoders
#
# Everything here is idempotent and reversible: `uninstall` puts the machine
# back exactly as it was.
#
# Usage: hw-enable [install|uninstall|status|doctor|scan-launchers [dir...]]
#
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BRIDGE_DIR="$(cd "$HERE/.." && pwd)"
SHIM="$HERE/libv4l2bridge.so"
PCI_SHIM="$HERE/libpcibridge.so"
NL_SHIM="$HERE/libnlbridge.so"
SYSFS_SHIM="$HERE/libsysfsbridge.so"
ALL_SHIMS="$SHIM $PCI_SHIM $NL_SHIM $SYSFS_SHIM"
CLIENT="$BRIDGE_DIR/bridge_client"
STATE_DIR="${BRIDGE_STATE_DIR:-$HOME/.cache/selinux-bridge}"
SYSFS_ROOT="$STATE_DIR/sysfs"

PROFILE_D=/etc/profile.d/20-selinux-bridge-hw.sh
GPU_PROFILE_D=/etc/profile.d/25-adreno-gpu.sh
ADRENO_PREFIX="${ADRENO_PREFIX:-/opt/mesa-adreno}"
LOCAL_BIN=/usr/local/bin
AUTOSTART_DIR="$HOME/.config/autostart"
AUTOSTART="$AUTOSTART_DIR/selinux-bridge-hw.desktop"
SESSION_HOOK="$HOME/.xprofile"
XFCE_XINITRC="${XDG_CONFIG_HOME:-$HOME/.config}/xfce4/xinitrc"
SYSTEM_XINITRC=/etc/xdg/xfce4/xinitrc
FFMPEG_PREFIX="${FFMPEG_PREFIX:-$HOME/build/ffmpeg-agc1-install}"
MARK_BEGIN="# >>> selinux-bridge hardware >>>"
# Marks a file this script created in its entirety, as opposed to one that
# already existed and merely had a block inserted. Uninstall removes the
# former and edits the latter, and guessing between the two from the file's
# shape is exactly the kind of heuristic that gets it wrong.
MARK_OWNED="# selinux-bridge: this whole file is generated"
MARK_END="# <<< selinux-bridge hardware <<<"

say()  { printf '%s\n' "$*"; }
ok()   { printf '  \033[32mok\033[0m    %s\n' "$*"; }
warn() { printf '  \033[33mwarn\033[0m  %s\n' "$*"; }
bad()  { printf '  \033[31mfail\033[0m  %s\n' "$*"; }

need_build() {
    local missing=0 f
    for f in $ALL_SHIMS; do [ -f "$f" ] || missing=1; done
    if [ "$missing" = 1 ]; then
        say "building the hardware shims..."
        ( cd "$HERE" && make --no-print-directory ) || {
            bad "could not build the shims in $HERE"
            exit 1
        }
    fi
}

# ---------------------------------------------------------------- install ---

write_profile() {
    cat > "$PROFILE_D" <<EOF
$MARK_BEGIN
# Generated by selinux-bridge/native/hw-enable. Do not edit by hand.
#
# Two small libraries are preloaded into every process:
#
#   libv4l2bridge.so  puts the phone's camera on /dev/video0, by interposing
#                     the handful of libc calls a V4L2 application makes.
#                     BRIDGE_V4L2_DISABLE=1 switches it off.
#
#   libpcibridge.so   lets Chromium's GPU process start, by answering the one
#                     unreadable /proc path libpci insists on. Without it any
#                     Chromium- or Electron-based application aborts on launch.
#                     BRIDGE_PCI_DISABLE=1 switches it off.
#
#   libnlbridge.so    hands out a working substitute for the kernel uevent
#                     netlink socket, which this container is not allowed to
#                     open. libudev gives up when that socket fails, and an
#                     application that asked libudev for devices is then told
#                     there are none -- which is why Chromium reported no
#                     camera *and* no microphone.
#                     BRIDGE_NETLINK_DISABLE=1 switches it off.
#
#   libsysfsbridge.so overlays a readable /sys/class/video4linux entry for the
#                     camera. Enumeration reads sysfs, not /dev, so without
#                     this the device list is empty however well /dev/video0
#                     behaves. BRIDGE_SYSFS_DISABLE=1 switches it off.
#
# All four are inert in a process that never touches those paths.
#
# One caveat, and it bites silently. These are glibc libraries, so any
# *bionic* binary launched from this container -- anything under
# /data/data/com.termux/files/usr/bin, which is how work is handed back to
# Android -- cannot link them, and dies with "CANNOT LINK EXECUTABLE" before
# it runs. A script that opens a browser, a file or the bridge app must clear
# both loader variables:
#
#   env -u LD_LIBRARY_PATH -u LD_PRELOAD /data/data/com.termux/files/usr/bin/am ...
#
# Clearing only LD_LIBRARY_PATH was sufficient before these shims existed, so
# older scripts tend to do exactly that and now fail. The failure looks like
# nothing happening at all: the wrapper exits 0 and no window appears.
# "hw-enable doctor" checks this path.

for _bridge_shim in "$SHIM" "$PCI_SHIM" "$NL_SHIM" "$SYSFS_SHIM"; do
    [ -f "\$_bridge_shim" ] || continue
    case ":\${LD_PRELOAD:-}:" in
        *":\$_bridge_shim:"*) ;;
        *) LD_PRELOAD="\${LD_PRELOAD:+\$LD_PRELOAD:}\$_bridge_shim" ;;
    esac
done
unset _bridge_shim
export LD_PRELOAD

# Where the shim and the tools find the bridge client.
export BRIDGE_CLIENT="$CLIENT"

# Where the synthetic sysfs entries live. Only paths that exist underneath
# are redirected; everything else in /sys is read from the real one.
export BRIDGE_SYSFS_ROOT="$SYSFS_ROOT"
$MARK_END
EOF
    chmod 0644 "$PROFILE_D"
    ok "$PROFILE_D"
}

# The GPU is the one piece of hardware here that needs no shim -- the driver
# stack is real and works -- but it still has to be *selected*, and until now
# only the desktop session did that. A shell logging straight into the
# container got the software rasteriser, which is why "adreno-run" existed.
# Putting the same activation in profile.d retires that wrapper.
#
# This is safe to apply container-wide because the prefix holds graphics
# libraries only: libGL, libEGL, libGLESv2, libgbm, libgallium and Turnip.
# Nothing else is shadowed, so a program that does no rendering is unaffected.
write_gpu_profile() {
    if [ ! -r "$ADRENO_PREFIX/activate.sh" ]; then
        warn "no GPU stack at $ADRENO_PREFIX -- skipping (shells keep llvmpipe)"
        return
    fi
    cat > "$GPU_PROFILE_D" <<EOF
#!/bin/sh
$MARK_BEGIN
# Generated by selinux-bridge/native/hw-enable.
#
# Puts every login shell on the Adreno GPU, so ordinary commands -- glxinfo,
# Blender, anything started from a terminal -- get hardware OpenGL with no
# wrapper. Without this the container falls back to llvmpipe, which is
# software rendering on the CPU.
#
# The XFCE session activates the same stack itself, because there it must be
# paired with an xfwm4 interlock (Zink without vblank_mode=xpresent blanks
# the display). When this file is sourced inside such a session it stands
# aside rather than redoing the work.
_adreno_prefix="$ADRENO_PREFIX"

# Hardware is the default, so the empty case is listed with the names that
# ask for it rather than being reached by falling off the end. An unknown
# value is a typo, and a typo must not be indistinguishable from "yes": when
# the mistake is 'of' for 'off' the caller wanted the GPU *off*, so the safe
# reading of anything unrecognised is the legacy renderer, said out loud.
case "\${XFCE_GPU:-}" in
    ''|auto|zink|adreno|turnip|gpu|on)
        if [ "\${GALLIUM_DRIVER:-}" = zink ] && [ -n "\${MESA_ADRENO_PREFIX:-}" ]; then
            : # already active, inherited from the session
        elif [ -r "\$_adreno_prefix/activate.sh" ]; then
            . "\$_adreno_prefix/activate.sh"
        fi
        ;;
    virgl|legacy|off)
        # The user asked for the legacy renderer; leave the environment be.
        ;;
    *)
        echo "[hw-enable] unknown XFCE_GPU='\$XFCE_GPU'; using the legacy renderer." \\
             "Expected: auto|zink|virgl|legacy|off" >&2
        ;;
esac

# These libraries must precede the system Mesa, or the old libGL is loaded
# against the new zink driver and GL dies with BadValue on
# X_GLXCreateNewContext. A shell that prepends its own paths can undo that
# order, so it is re-asserted rather than assumed.
if [ "\${GALLIUM_DRIVER:-}" = zink ] && [ -n "\${MESA_ADRENO_PREFIX:-}" ]; then
    case ":\${LD_LIBRARY_PATH:-}:" in
        ":\$MESA_ADRENO_PREFIX/lib:"*) ;;
        *) LD_LIBRARY_PATH="\$MESA_ADRENO_PREFIX/lib:\${LD_LIBRARY_PATH:-}"
           export LD_LIBRARY_PATH ;;
    esac
fi
unset _adreno_prefix
$MARK_END
EOF
    chmod 0644 "$GPU_PROFILE_D"
    ok "$GPU_PROFILE_D (hardware OpenGL in every shell)"
}

# Applications launched from the desktop inherit the session environment, not
# a login shell's, so the same settings have to reach the X session too.
#
# ~/.xprofile is the conventional place and several display managers read it,
# but `startxfce4` on this system does not: it execs
# $XDG_CONFIG_HOME/xfce4/xinitrc when that exists and /etc/xdg/xfce4/xinitrc
# otherwise, and neither sources .xprofile. Writing only .xprofile therefore
# looks installed and does nothing, which is the failure mode worth avoiding
# -- menu-launched applications would silently miss the camera while a
# terminal-launched one found it. So both are written.
write_session_hook() {
    local tmp
    tmp="$(mktemp)"
    if [ -f "$SESSION_HOOK" ]; then
        sed "/$MARK_BEGIN/,/$MARK_END/d" "$SESSION_HOOK" > "$tmp"
    fi
    cat >> "$tmp" <<EOF
$MARK_BEGIN
# Generated by selinux-bridge/native/hw-enable. Do not edit by hand.
[ -f "$PROFILE_D" ] && . "$PROFILE_D"
$MARK_END
EOF
    mv "$tmp" "$SESSION_HOOK"
    chmod 0644 "$SESSION_HOOK"
    ok "$SESSION_HOOK (display managers that read it)"

    mkdir -p "$(dirname "$XFCE_XINITRC")"

    # Both branches below emit the same block, and both rewrite it rather than
    # leaving whatever an older version of this script wrote. An install that
    # says "already hooked" and keeps a stale hook is the worst kind of
    # upgrade: it reports success and changes nothing.
    local blk
    blk="$(mktemp)"
    cat > "$blk" <<EOF
$MARK_BEGIN
# Generated by selinux-bridge/native/hw-enable. Do not edit by hand.
#
# startxfce4 execs this file in place of $SYSTEM_XINITRC when it exists, so
# it is the one place where the whole desktop session -- and therefore every
# application launched from a menu or a panel -- can be given the same
# environment a login shell gets.
[ -f "$PROFILE_D" ] && . "$PROFILE_D"
[ -f "$GPU_PROFILE_D" ] && . "$GPU_PROFILE_D"
EOF
    # Quoted heredoc: this block is shell for the *session* to run at
    # start-up, not for this script to evaluate now. Expanding it here
    # would run xfconf-query at install time, which is both wrong and,
    # under 'set -u', fatal.
    cat >> "$blk" <<'EOF'

# Zink in a session environment is only safe alongside xfwm4
# vblank_mode=xpresent. xfwm4's GL renderer blacklist is
# "Software Rasterizer / llvmpipe / SVGA3D / virgl"; zink is not on it, so
# xfwm4 enables its GLX compositor, which termux-x11 cannot present -- the
# session composites correctly into an overlay that never reaches the
# display, giving a black screen with no error anywhere.
#
# This check lives here rather than only in whichever script launched the
# session, because this file is what startxfce4 actually execs, and the
# login shell that reached it has already been handed the full Zink
# environment by profile.d. If the interlock cannot be confirmed the Adreno
# environment is cleared outright: the slower renderer is a far better
# failure than a desktop that never appears. Clearing GALLIUM_DRIVER alone
# would not be enough, as MESA_LOADER_DRIVER_OVERRIDE outranks it.
if [ "${GALLIUM_DRIVER:-}" = zink ]; then
    _vb=""
    _xfwm_xml="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml"

    # Asking xfconf is the authoritative check, but xfconf-query speaks D-Bus
    # and at this point in start-up there is normally no session bus yet:
    # neither startxfce4 nor /etc/xdg/xfce4/xinitrc starts one, xfce4-session
    # does, and that runs later. Left to itself xfconf-query autolaunches a
    # private bus, which then outlives the session as a stray daemon. So the
    # bus is handled explicitly, and every call is bounded -- a session that
    # hangs here never appears at all, which is worse than either outcome
    # this interlock is choosing between.
    if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && \
       command -v xfconf-query >/dev/null 2>&1; then
        timeout 10 xfconf-query -c xfwm4 -p /general/vblank_mode -n -t string \
                     -s xpresent >/dev/null 2>&1
        _vb="$(timeout 10 xfconf-query -c xfwm4 -p /general/vblank_mode 2>/dev/null)"
    elif command -v dbus-run-session >/dev/null 2>&1 && \
         command -v xfconf-query >/dev/null 2>&1; then
        # A private bus that exits with the command, rather than one that
        # lingers for the rest of the session.
        _vb="$(timeout 20 dbus-run-session -- sh -c \
            'xfconf-query -c xfwm4 -p /general/vblank_mode -n -t string \
                          -s xpresent >/dev/null 2>&1
             xfconf-query -c xfwm4 -p /general/vblank_mode 2>/dev/null')"
    fi

    # Last resort, and the only check that needs no D-Bus at all: xfconf is
    # an interface onto a file, and that file is what xfwm4 will actually
    # read at start-up, so it answers the question directly.
    if [ "$_vb" != xpresent ] && [ -r "$_xfwm_xml" ]; then
        if grep -q 'name="vblank_mode"[^>]*value="xpresent"' "$_xfwm_xml"; then
            _vb=xpresent
        fi
    fi

    if [ "$_vb" != xpresent ]; then
        unset MESA_LOADER_DRIVER_OVERRIDE VK_DRIVER_FILES VK_ICD_FILENAMES \
              LIBGL_DRIVERS_PATH MESA_VK_WSI_DEBUG MESA_ADRENO_PREFIX
        GALLIUM_DRIVER=virpipe
        export GALLIUM_DRIVER
        echo "[hw-enable] vblank_mode=xpresent unconfirmed; session on virpipe" >&2
    fi
    unset _vb _xfwm_xml
fi
EOF
    printf '%s\n' "$MARK_END" >> "$blk"

    if [ ! -f "$XFCE_XINITRC" ] || grep -qF "$MARK_OWNED" "$XFCE_XINITRC"; then
        # Ours, or not there at all: write the whole file.
        {
            printf '%s\n%s\n' "#!/bin/sh" "$MARK_OWNED"
            cat "$blk"
            cat <<EOF

# Hand over to the session proper. A wrapper that cannot start the session
# is worse than no wrapper at all -- it is a desktop that does not come up --
# so this does not assume the exec bit survived whatever put the file there.
if [ -x "$SYSTEM_XINITRC" ]; then
    exec "$SYSTEM_XINITRC" "\$@"
else
    exec /bin/sh "$SYSTEM_XINITRC" "\$@"
fi
EOF
        } > "$XFCE_XINITRC"
        chmod 0755 "$XFCE_XINITRC"
        ok "$XFCE_XINITRC (desktop-launched apps)"
    else
        # Someone else's file: replace any block of ours and leave the rest be.
        # It gets the interlock too. profile.d has already put this login shell
        # on Zink by the time startxfce4 runs, so a foreign xinitrc is exposed
        # to exactly the same black screen -- the hook is what protects it.
        tmp="$(mktemp)"
        {
            head -1 "$XFCE_XINITRC"
            cat "$blk"
            tail -n +2 "$XFCE_XINITRC" | sed "/$MARK_BEGIN/,/$MARK_END/d"
        } > "$tmp"
        cat "$tmp" > "$XFCE_XINITRC"
        rm -f "$tmp"
        ok "$XFCE_XINITRC (hook refreshed in your existing file)"
    fi
    rm -f "$blk"
}

write_termux_run() {
    cat > "$LOCAL_BIN/termux-run" <<'EOF'
#!/bin/sh
# Generated by selinux-bridge/native/hw-enable.
#
# Run a Termux/Android binary from inside the container.
#
# This exists because the container and Android use different C libraries.
# Everything in here is glibc; everything under $TERMUX_BIN is bionic. The
# hardware shims this project installs are glibc shared objects exported in
# LD_PRELOAD for every login shell, and a bionic binary cannot link them --
# it aborts with "CANNOT LINK EXECUTABLE" before running any of its own code.
# The same applies to LD_LIBRARY_PATH, which points at the container's Mesa.
#
# So both loader variables have to be cleared for the crossing. Clearing only
# LD_LIBRARY_PATH was enough before the shims were made global, which is why
# scripts written earlier fail now, and fail silently: the caller exits 0 and
# nothing appears.
#
# Use this instead of calling am/pm/termux-* directly:
#
#   termux-run am start -a android.intent.action.VIEW -d https://example.com
#   termux-run termux-open /sdcard/file.pdf
#
# It is safe from a normal shell too: clearing variables that are already
# unset is a no-op.
set -eu

TERMUX_BIN=${TERMUX_BIN:-/data/data/com.termux/files/usr/bin}

if [ "$#" -eq 0 ]; then
    echo "usage: termux-run <android-or-termux-command> [args...]" >&2
    echo "       runs the command with LD_PRELOAD and LD_LIBRARY_PATH cleared," >&2
    echo "       which is what bionic binaries need to start." >&2
    exit 64
fi

cmd=$1
shift

# Accept a bare name, an absolute path, or a name that only exists on the
# Termux side of the filesystem.
if [ "${cmd#/}" = "$cmd" ] && [ -x "$TERMUX_BIN/$cmd" ]; then
    cmd="$TERMUX_BIN/$cmd"
fi

if [ ! -x "$cmd" ] && ! command -v "$cmd" >/dev/null 2>&1; then
    echo "termux-run: cannot find '$cmd'" >&2
    echo "  looked in $TERMUX_BIN and on PATH." >&2
    echo "  if Termux lives somewhere else, set TERMUX_BIN." >&2
    exit 127
fi

exec env -u LD_PRELOAD -u LD_LIBRARY_PATH \
     PATH="$TERMUX_BIN:/system/bin:/system/xbin:$PATH" \
     "$cmd" "$@"
EOF
    chmod 0755 "$LOCAL_BIN/termux-run"
    ok "$LOCAL_BIN/termux-run (safe crossing to Android binaries)"
}

write_ffmpeg_wrappers() {
    if [ ! -x "$FFMPEG_PREFIX/bin/ffmpeg" ]; then
        warn "no bridge ffmpeg at $FFMPEG_PREFIX -- leaving the system ffmpeg alone"
        return
    fi
    local tool
    for tool in ffmpeg ffprobe ffplay; do
        [ -x "$FFMPEG_PREFIX/bin/$tool" ] || continue
        cat > "$LOCAL_BIN/$tool" <<EOF
#!/bin/sh
# Generated by selinux-bridge/native/hw-enable.
#
# The build behind this wrapper is the stock ffmpeg plus the bridge's own
# encoders and decoders (h264_selinuxbridge, hevc_selinuxbridge), so the
# hardware codecs are reachable from anything that shells out to ffmpeg.
#
# LD_LIBRARY_PATH is set here and not globally on purpose: these shared
# objects must be found by these three binaries and by nothing else, or
# every other application linked against the system libavcodec would be
# silently switched onto a different build of it.
LD_LIBRARY_PATH="$FFMPEG_PREFIX/lib\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH
exec "$FFMPEG_PREFIX/bin/$tool" "\$@"
EOF
        chmod 0755 "$LOCAL_BIN/$tool"
        ok "$LOCAL_BIN/$tool -> bridge build"
    done
}

# The synthetic sysfs entry. libudev, GStreamer and every Chromium-derived
# browser enumerate cameras by walking /sys/class/video4linux and reading
# `name` and `dev` out of each entry -- they never scan /dev -- so without
# this the camera does not appear, no matter how well /dev/video0 answers.
#
# It is generated rather than committed because it has to name this device,
# and because the symlink layout has to match what a real driver produces:
# the class entry is a link into /sys/devices, and each device links back to
# its subsystem. udev follows both, and rejects an entry where they disagree.
write_sysfs_tree() {
    local dev="$SYSFS_ROOT/devices/platform/soc/soc:qcom,cam-req-mgr/video4linux/video0"
    rm -rf "$SYSFS_ROOT"
    mkdir -p "$dev" "$SYSFS_ROOT/class/video4linux" \
             "$SYSFS_ROOT/subsystem/video4linux/devices" "$SYSFS_ROOT/bus"

    printf 'Phone Camera (SELinux Bridge)\n' > "$dev/name"
    printf '81:0\n'                          > "$dev/dev"
    printf '0\n'                             > "$dev/index"
    printf 'MAJOR=81\nMINOR=0\nDEVNAME=video0\n' > "$dev/uevent"

    ln -sfn /sys/class/video4linux "$dev/subsystem"
    ln -sfn "../../devices/platform/soc/soc:qcom,cam-req-mgr/video4linux/video0" \
            "$SYSFS_ROOT/class/video4linux/video0"
    ln -sfn "../../../devices/platform/soc/soc:qcom,cam-req-mgr/video4linux/video0" \
            "$SYSFS_ROOT/subsystem/video4linux/devices/video0"

    ok "$SYSFS_ROOT (camera visible to device enumeration)"
}

write_autostart() {
    mkdir -p "$AUTOSTART_DIR"
    cat > "$AUTOSTART" <<EOF
[Desktop Entry]
Type=Application
Name=SELinux Bridge hardware
Comment=Publishes the phone microphone as the default PulseAudio source
Exec=$HERE/hw-session start
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF
    chmod 0644 "$AUTOSTART"
    ok "$AUTOSTART (microphone at login)"
}

do_install() {
    need_build
    say "installing native hardware access..."
    write_sysfs_tree
    write_profile
    write_gpu_profile
    write_session_hook
    write_ffmpeg_wrappers
    write_termux_run
    write_autostart
    say ""
    say "starting the microphone bridge now..."
    "$HERE/hw-session" start || warn "microphone bridge did not start (see status)"
    say ""
    say "done. Open a new shell, or run:  . $PROFILE_D"
}

# -------------------------------------------------------------- uninstall ---

do_uninstall() {
    say "removing native hardware access..."
    "$HERE/hw-session" stop >/dev/null 2>&1

    rm -f "$PROFILE_D" && ok "removed $PROFILE_D"
    [ -f "$GPU_PROFILE_D" ] && rm -f "$GPU_PROFILE_D" && ok "removed $GPU_PROFILE_D"
    rm -f "$AUTOSTART" && ok "removed $AUTOSTART"

    local tool
    for tool in ffmpeg ffprobe ffplay termux-run; do
        if [ -f "$LOCAL_BIN/$tool" ] && grep -q "selinux-bridge" "$LOCAL_BIN/$tool" 2>/dev/null; then
            rm -f "$LOCAL_BIN/$tool" && ok "removed $LOCAL_BIN/$tool"
        fi
    done

    if [ -f "$SESSION_HOOK" ]; then
        local tmp
        tmp="$(mktemp)"
        sed "/$MARK_BEGIN/,/$MARK_END/d" "$SESSION_HOOK" > "$tmp"
        if [ -s "$tmp" ]; then mv "$tmp" "$SESSION_HOOK"; else rm -f "$tmp" "$SESSION_HOOK"; fi
        ok "cleaned $SESSION_HOOK"
    fi

    if [ -f "$XFCE_XINITRC" ] && grep -qF "$MARK_BEGIN" "$XFCE_XINITRC"; then
        # If the file is nothing but our wrapper, remove it so startxfce4
        # goes back to the system one; otherwise just take our block out.
        if grep -qF "$MARK_OWNED" "$XFCE_XINITRC"; then
            rm -f "$XFCE_XINITRC" && ok "removed $XFCE_XINITRC"
        else
            local tmp2
            tmp2="$(mktemp)"
            sed "/$MARK_BEGIN/,/$MARK_END/d" "$XFCE_XINITRC" > "$tmp2"
            cat "$tmp2" > "$XFCE_XINITRC"
            rm -f "$tmp2"
            ok "cleaned $XFCE_XINITRC"
        fi
    fi
    say ""
    say "done. Existing shells still have LD_PRELOAD set; open a new one."
}

# ----------------------------------------------------------------- status ---

do_status() {
    say "native hardware access"
    say ""

    say "camera (/dev/video0):"
    [ -f "$SHIM" ] && ok "shim built: $SHIM" || bad "shim not built"
    [ -f "$PROFILE_D" ] && ok "installed system-wide" || warn "not installed"
    case ":${LD_PRELOAD:-}:" in
        *":$SHIM:"*) ok "active in this shell" ;;
        *) warn "not active in this shell (open a new one)" ;;
    esac

    # A login shell and the desktop session get their environment from
    # different places, and only one of them can be fixed without a restart.
    local spid=""
    for d in /proc/[0-9]*; do
        case "$(cat "$d/comm" 2>/dev/null)" in
            xfce4-session|xfdesktop) spid="${d#/proc/}"; break ;;
        esac
    done
    if [ -n "$spid" ]; then
        if tr '\0' '\n' < "/proc/$spid/environ" 2>/dev/null | grep -q "^LD_PRELOAD=.*libv4l2bridge"; then
            ok "the running desktop session has it (menu-launched apps too)"
        else
            warn "the running desktop session predates this install --"
            warn "  apps launched from the menu will not see the hardware"
            warn "  until you restart the session; new terminals are fine"
        fi
    fi

    say ""
    say "device enumeration (what libudev and browsers read):"
    [ -f "$NL_SHIM" ] && ok "uevent socket shim built" || bad "uevent socket shim not built"
    [ -f "$SYSFS_SHIM" ] && ok "sysfs overlay shim built" || bad "sysfs overlay shim not built"
    if [ -e "$SYSFS_ROOT/class/video4linux/video0/name" ]; then
        ok "sysfs entry: $(cat "$SYSFS_ROOT/class/video4linux/video0/name")"
    else
        warn "no sysfs entry (run: hw-enable install)"
    fi

    say ""
    say "microphone (PulseAudio):"
    "$HERE/hw-session" status 2>&1 | sed 's/^/  /'

    say ""
    say "GPU:"
    local r
    r="$(timeout 60 glxinfo -B 2>/dev/null | sed -n 's/^OpenGL renderer string: //p')"
    case "$r" in
        *Adreno*|*zink*) ok "hardware: $r" ;;
        "")              warn "no GL (no display?)" ;;
        *)               warn "software: $r" ;;
    esac
    if [ -f "$GPU_PROFILE_D" ]; then
        ok "every login shell is put on the GPU (no adreno-run needed)"
    elif [ -r "$ADRENO_PREFIX/activate.sh" ]; then
        warn "shells are not put on the GPU; run: hw-enable install"
    fi
    [ -f "$PCI_SHIM" ] && ok "Chromium/Electron shim built: $PCI_SHIM" \
                       || bad "Chromium/Electron shim not built"
    case ":${LD_PRELOAD:-}:" in
        *":$PCI_SHIM:"*) ok "Chromium/Electron shim active in this shell" ;;
        *) warn "Chromium/Electron shim not active (open a new shell)" ;;
    esac

    say ""
    say "hardware codecs (ffmpeg on PATH):"
    local ff
    ff="$(command -v ffmpeg 2>/dev/null)"
    if [ -z "$ff" ]; then
        bad "no ffmpeg on PATH"
    elif ffmpeg -hide_banner -encoders 2>/dev/null | grep -q selinuxbridge; then
        ok "$ff has the bridge codecs"
    else
        warn "$ff is the stock build (no bridge codecs)"
    fi
}

# ----------------------------------------------------------------- doctor ---

# Proves each path end to end rather than reporting that a file exists.
# Find scripts that run a Termux/Android binary without clearing LD_PRELOAD.
# Prints "risky <path>" for each, then "scanned <n>". Used by doctor, and on
# its own as "hw-enable scan-launchers [dir...]" so it can be tested quickly.
#
# Three things look like a crossing and are not, and a check that cries wolf
# is a check people learn to ignore:
#   - compiled programs, which carry such paths as data (grep -I skips them);
#   - comments, which mention a path without running anything;
#   - guards written in another language. Python, for instance, clears the
#     variables by filtering them out of the environment it passes on.
scan_launchers() {
    local d f code n=0
    local cleared='-u[[:space:]]+LD_PRELOAD'
    cleared+='|unset[[:space:]]+([A-Za-z_]+[[:space:]]+)*LD_PRELOAD'
    cleared+="|pop\\([\"']LD_PRELOAD"
    cleared+="|not in [({\\[][^)}]*[\"']LD_PRELOAD"
    cleared+="|del [A-Za-z_.]+\\[[\"']LD_PRELOAD"
    for d in "$@"; do
        [ -d "$d" ] || continue
        for f in "$d"/*; do
            [ -f "$f" ] && [ -r "$f" ] || continue
            [ "${f##*/}" = termux-run ] && continue   # the helper itself
            grep -Iq . "$f" 2>/dev/null || continue
            code="$(grep -vE '^[[:space:]]*#' "$f" 2>/dev/null)"
            printf '%s\n' "$code" | grep -qE 'com\.termux/files|termux-open|termux-run' || continue
            n=$((n + 1))
            printf '%s\n' "$code" | grep -q 'termux-run' && continue
            printf '%s\n' "$code" | grep -qE -- "$cleared" && continue
            printf 'risky %s\n' "$f"
        done
    done
    printf 'scanned %s\n' "$n"
}

do_doctor() {
    local fails=0

    say "checking the bridge..."
    if "$BRIDGE_DIR/tools/bridge-status" >/dev/null 2>&1; then
        ok "bridge reachable on the loopback port"
    else
        bad "bridge unreachable -- is the app running on the phone?"
        fails=$((fails + 1))
    fi

    say ""
    say "checking the camera as an ordinary application sees it..."
    local out
    out="$(LD_PRELOAD="$SHIM" timeout 120 ffmpeg -hide_banner -f v4l2 -i /dev/video0 \
             -frames:v 10 -f null - 2>&1 </dev/null)"
    if printf '%s' "$out" | grep -qE "frame= *10"; then
        ok "captured 10 frames from /dev/video0 ($(printf '%s' "$out" | sed -n 's/.*Video: rawvideo.*, \([0-9]*x[0-9]*\),.*/\1/p' | head -1))"
    else
        bad "could not capture from /dev/video0"
        printf '%s\n' "$out" | tail -3 | sed 's/^/        /'
        fails=$((fails + 1))
    fi

    say ""
    say "checking that the camera is discoverable, not just openable..."
    # Opening /dev/video0 and finding /dev/video0 are different problems.
    # Browsers and GStreamer never scan /dev; they ask libudev, which walks
    # sysfs and needs the uevent netlink socket to initialise at all. This
    # exercises that path exactly as they do.
    local udev
    udev="$(LD_PRELOAD="$NL_SHIM:$SYSFS_SHIM" BRIDGE_SYSFS_ROOT="$SYSFS_ROOT" \
            timeout 60 udevadm info --path=/class/video4linux/video0 2>&1)"
    if printf '%s' "$udev" | grep -q "^N: video0"; then
        ok "libudev resolves video0 as $(printf '%s' "$udev" | sed -n 's/^D: //p') in subsystem $(printf '%s' "$udev" | sed -n 's/^U: //p')"
    else
        bad "libudev cannot see the camera -- browsers will report no devices"
        printf '%s\n' "$udev" | tail -2 | sed 's/^/        /'
        fails=$((fails + 1))
    fi

    # Being able to resolve a path someone hands you is not the same as
    # being able to find the device in the first place, and toolkits do the
    # latter: GStreamer's device provider and gudev scan the subsystem.
    local scan
    scan="$(LD_PRELOAD="$NL_SHIM:$SYSFS_SHIM" BRIDGE_SYSFS_ROOT="$SYSFS_ROOT" \
            timeout 60 udevadm trigger --subsystem-match=video4linux \
                                       --dry-run --verbose 2>&1)"
    if printf '%s' "$scan" | grep -q "/video4linux/video0$"; then
        ok "a subsystem scan discovers it (what GStreamer and gudev do)"
    else
        bad "the camera can be resolved but not discovered by a scan"
        printf '%s\n' "$scan" | tail -2 | sed 's/^/        /'
        fails=$((fails + 1))
    fi

    # A blanket /sys redirect would break the C library itself, so confirm
    # the overlay is additive.
    if [ "$(LD_PRELOAD="$SYSFS_SHIM" BRIDGE_SYSFS_ROOT="$SYSFS_ROOT" \
            cat /sys/devices/system/cpu/online 2>/dev/null)" = \
         "$(cat /sys/devices/system/cpu/online 2>/dev/null)" ]; then
        ok "real sysfs still reads through unchanged"
    else
        bad "the sysfs overlay is shadowing real entries"
        fails=$((fails + 1))
    fi

    say ""
    say "checking the microphone as an ordinary application sees it..."
    local defsrc
    defsrc="$(pactl info 2>/dev/null | sed -n 's/^Default Source: //p')"
    # phone_mic is the remapped source that applications which hide monitors
    # will accept; bridge_mic.monitor is the fallback when the remap fails.
    if [ -n "$defsrc" ] && printf '%s' "$defsrc" | grep -qE 'phone_mic|bridge_mic'; then
        ok "default source is $defsrc"
        rm -f /tmp/hw-doctor-mic.wav
        parec --device="$defsrc" --file-format=wav /tmp/hw-doctor-mic.wav \
              >/dev/null 2>&1 &
        local pp=$!
        sleep 3
        kill "$pp" 2>/dev/null
        wait "$pp" 2>/dev/null
        local sz
        sz=$(stat -c %s /tmp/hw-doctor-mic.wav 2>/dev/null || echo 0)
        if [ "$sz" -gt 10000 ]; then
            ok "recorded $sz bytes of live audio in 3 s"
        else
            warn "recorded only $sz bytes -- the source exists but is not flowing"
            fails=$((fails + 1))
        fi
        rm -f /tmp/hw-doctor-mic.wav
    else
        bad "default source is '${defsrc:-none}', not the phone microphone"
        fails=$((fails + 1))
    fi

    say ""
    say "checking the GPU..."
    local r
    r="$(timeout 60 glxinfo -B 2>/dev/null | sed -n 's/^OpenGL renderer string: //p')"
    case "$r" in
        *Adreno*|*zink*) ok "$r" ;;
        *) bad "not on the GPU: ${r:-no GL}"; fails=$((fails + 1)) ;;
    esac

    # That the GPU works in *this* shell says nothing about a shell someone
    # else opens, and for a long time the answer differed: the desktop
    # session selected the Adreno stack while a plain login got the software
    # rasteriser, which is the whole reason a wrapper like adreno-run
    # existed. Ask a fresh login shell rather than assuming it matches.
    local fresh
    fresh="$(env -i HOME="$HOME" USER="${USER:-$(id -un)}" TERM=dumb \
                 DISPLAY="${DISPLAY:-:0}" \
             timeout 90 bash -lc 'glxinfo -B 2>/dev/null \
                 | sed -n "s/^OpenGL renderer string: //p"' 2>/dev/null)"
    case "$fresh" in
        *Adreno*|*zink*) ok "a brand-new login shell gets it too, with no wrapper" ;;
        *)  bad "a fresh login shell falls back to '${fresh:-no GL}' -- GPU apps"
            bad "  started outside the desktop session would run on the CPU"
            fails=$((fails + 1)) ;;
    esac

    # Chromium is checked separately because it fails in its own way: the
    # browser aborts during start-up, before any page loads, so "does GL
    # work" says nothing about whether a browser can run at all.
    if command -v chromium >/dev/null 2>&1; then
        say ""
        say "checking that Chromium-based applications can start..."
        local prof cout
        prof="$(mktemp -d)"
        cout="$(LD_PRELOAD="$PCI_SHIM" timeout 120 chromium --headless=new \
                  --no-sandbox --user-data-dir="$prof" \
                  --dump-dom 'data:text/html,<title>ok</title>' 2>&1 </dev/null)"
        rm -rf "$prof"
        if printf '%s' "$cout" | grep -q "GPU process isn't usable"; then
            bad "Chromium still aborts on start-up"
            fails=$((fails + 1))
        elif printf '%s' "$cout" | grep -q "<title>ok</title>"; then
            ok "Chromium starts and renders a page"
        else
            warn "Chromium did not render as expected"
            printf '%s\n' "$cout" | tail -3 | sed 's/^/        /'
            fails=$((fails + 1))
        fi
    fi

    say ""
    say "checking that Termux/Android binaries are still reachable..."
    local termux_am="/data/data/com.termux/files/usr/bin/am"
    if [ ! -x "$termux_am" ]; then
        warn "no Termux am on this system -- skipping"
    else
        # Anything that hands work back to Android -- opening a browser, a
        # file, or the bridge app itself -- runs a bionic binary. The shim
        # environment above is glibc, and bionic's linker refuses it outright
        # ("CANNOT LINK EXECUTABLE"). That is inherent, not a bug: the fix is
        # for the caller to strip the container's loader variables. This
        # checks the documented escape hatch still works, because when it
        # stops working every desktop launcher that opens a browser dies
        # silently -- the launcher exits 0 and simply nothing appears.
        local bare stripped
        bare="$("$termux_am" 2>&1 </dev/null | head -2)"
        stripped="$(env -u LD_LIBRARY_PATH -u LD_PRELOAD \
                        "$termux_am" 2>&1 </dev/null | head -2)"
        if printf '%s' "$stripped" | grep -q "Activity manager"; then
            ok "env -u LD_LIBRARY_PATH -u LD_PRELOAD reaches Android's am"
            if printf '%s' "$bare" | grep -q "CANNOT LINK EXECUTABLE"; then
                printf '        a bare call still cannot link, as expected --\n'
                printf '        callers must strip both variables, not just\n'
                printf '        LD_LIBRARY_PATH\n'
            fi
        else
            bad "cannot reach Android's am even with the loader variables stripped"
            printf '%s\n' "$stripped" | sed 's/^/        /'
            printf '        anything that opens a browser or a file on Android\n'
            printf '        is broken\n'
            fails=$((fails + 1))
        fi

        # The helper that exists so no future script has to remember the
        # rule above. It is only useful if it actually crosses.
        if [ -x "$LOCAL_BIN/termux-run" ]; then
            if "$LOCAL_BIN/termux-run" am 2>&1 </dev/null |
                    grep -q "Activity manager"; then
                ok "termux-run crosses to Android correctly"
            else
                bad "termux-run is installed but cannot reach Android"
                fails=$((fails + 1))
            fi
        else
            warn "no $LOCAL_BIN/termux-run -- run 'hw-enable install'"
            printf '        scripts then have to strip both loader variables\n'
            printf '        by hand, which is the thing that keeps being missed\n'
        fi

        # Knowing the crossing works is not the same as knowing everything
        # uses it. The browsers broke in scripts that predate the shims, and
        # the only reason it took a user report is that nothing looked. This
        # sweeps the places launchers actually live, so a script written
        # today with the old one-variable habit is caught here rather than by
        # someone double-clicking an icon and getting silence.
        local risky_list scanned risky
        risky_list="$(scan_launchers "$HOME/.local/bin" "$HOME/bin" \
                        "$LOCAL_BIN" "$HOME/.config/autostart")"
        scanned="$(printf '%s\n' "$risky_list" | sed -n 's/^scanned //p')"
        risky="$(printf '%s\n' "$risky_list" | grep -c '^risky ')"
        printf '%s\n' "$risky_list" | sed -n 's/^risky /        /p'
        if [ "$risky" -gt 0 ]; then
            bad "$risky of $scanned launcher(s) reach Android without clearing LD_PRELOAD"
            printf '        listed above. They will die in the linker and\n'
            printf '        appear to do nothing at all. Use termux-run, or\n'
            printf '        env -u LD_LIBRARY_PATH -u LD_PRELOAD.\n'
            fails=$((fails + 1))
        elif [ "$scanned" -gt 0 ]; then
            ok "all $scanned launcher(s) that reach Android clear both variables"
        fi
    fi

    say ""
    say "checking the hardware codecs..."
    if ffmpeg -hide_banner -encoders 2>/dev/null | grep -q h264_selinuxbridge; then
        ok "h264_selinuxbridge present in $(command -v ffmpeg)"
    else
        bad "ffmpeg on PATH has no bridge codecs"
        fails=$((fails + 1))
    fi

    say ""
    if [ "$fails" = 0 ]; then
        say "all native hardware paths are working."
    else
        say "$fails check(s) failed."
    fi
    return "$fails"
}

case "${1:-status}" in
    install)   do_install ;;
    uninstall) do_uninstall ;;
    status)    do_status ;;
    doctor)    do_doctor ;;
    scan-launchers)
        shift
        [ "$#" -gt 0 ] || set -- "$HOME/.local/bin" "$HOME/bin" "$LOCAL_BIN" \
                                "$HOME/.config/autostart"
        out="$(scan_launchers "$@")"
        printf '%s\n' "$out"
        ! printf '%s\n' "$out" | grep -q '^risky ' ;;
    *) say "usage: hw-enable [install|uninstall|status|doctor|scan-launchers [dir...]]" >&2; exit 2 ;;
esac
